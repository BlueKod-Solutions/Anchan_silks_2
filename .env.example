# ─────────────────────────────────────────────────────────────────────────────
# ANCHAN SILKS — Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# EmailJS — https://www.emailjs.com/
# Set up a free account, create a service + template, copy the IDs here
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Analytics 4
# Create a GA4 property at analytics.google.com and copy the Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary (for image hosting — optional if using /public directly)
# https://cloudinary.com/ — free tier is sufficient
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
